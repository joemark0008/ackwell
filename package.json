{
  "name": "ackwell",
  "private": true,
  "license": "Apache-2.0",
  "description": "HL7 v2 integration engine: MLLP in, lossless JSON out, signed webhooks, JSON back to HL7 with ACK tracking.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/joemark0008/ackwell.git"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "npm@10.9.9",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck"
  },
  "devDependencies": {
    "turbo": "^2.11.10",
    "typescript": "^5.9.3"
  }
}
