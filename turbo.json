{
  "$schema": "https://turbo.build/schema.json",
  "ui": "stream",
  "globalPassThroughEnv": [
    "NODE_ENV",
    "DATABASE_URL",
    "BETTER_AUTH_SECRET",
    "PORT",
    "SEED_ADMIN_PASSWORD",
    "SEED_ADMIN_EMAIL",
    "APP_URL",
    "PUBLIC_HOST",
    "API_PROXY_TARGET",
    "MLLP_PORT_RANGE",
    "MLLP_ADVERTISED_HOST",
    "MLLP_BIND_ADDRESS",
    "RETENTION_DEFAULT_DAYS",
    "FILE_ROOT",
    "DELIVERY_RETRY_DELAY_SECONDS",
    "QUEUE_POLL_SECONDS",
    "LOG_LEVEL",
    "LOG_PRETTY",
    "DOCKER_HOST",
    "TESTCONTAINERS_*"
  ],
  "tasks": {
    "build": {
      "dependsOn": [
        "^build"
      ],
      "outputs": [
        "dist/**"
      ]
    },
    "dev": {
      "dependsOn": [
        "^build"
      ],
      "cache": false,
      "persistent": true
    },
    "test": {
      "dependsOn": [
        "^build"
      ],
      "cache": false
    },
    "typecheck": {
      "dependsOn": [
        "^build"
      ]
    },
    "lint": {}
  }
}
