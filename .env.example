# Copy to .env and fill in. Never commit .env. In Coolify (or any platform), set these as environment variables.

# --- Required ---------------------------------------------------------------------------------------------
# Local dev: postgres://ackwell:ackwell@localhost:5432/ackwell (see README). Not used by docker-compose.prod.yml,
# which builds it from POSTGRES_* below.
DATABASE_URL=postgres://ackwell:ackwell@localhost:5432/ackwell
# Signs sessions. 32+ characters, keep it stable: openssl rand -base64 32
BETTER_AUTH_SECRET=CHANGE_ME_AT_LEAST_32_CHARS
# Public URL users open (trusted origin for sign-in). Local dev: http://localhost:5173
APP_URL=http://localhost:5173

# --- First admin (optional) -------------------------------------------------------------------------------
# Leave both unset to use the setup wizard: the API prints a one-time token to its log, enter it at /setup.
# Set both for unattended installs; used only while the user table is empty.
# SEED_ADMIN_EMAIL=admin@example.com
# SEED_ADMIN_PASSWORD=CHANGE_ME_MIN_12_CHARS

# --- MLLP --------------------------------------------------------------------------------------------------
# Ports inbound channels may listen on
MLLP_PORT_RANGE=6100-6150
# Host or IP shown to senders in the UI
MLLP_ADVERTISED_HOST=localhost
# Host address the compose files publish the MLLP range on (use a LAN IP, not 0.0.0.0, on a public server)
# MLLP_BIND_IP=192.0.2.30
# Address the listeners bind inside the container (default 0.0.0.0)
# MLLP_BIND_ADDRESS=0.0.0.0

# --- Other ------------------------------------------------------------------------------------------------
PORT=3000
RETENTION_DEFAULT_DAYS=7
# Webhook delivery retries: base delay (exponential backoff, max 10 min) and worker poll interval
DELIVERY_RETRY_DELAY_SECONDS=10
QUEUE_POLL_SECONDS=2
# Shared folder for file-transport channels (absolute path). Unset = file channels disabled.
# FILE_ROOT=/data/files
# Require "Authorization: Bearer <token>" on GET /metrics (min 16 chars). Unset = open.
# METRICS_TOKEN=
LOG_LEVEL=info

# --- docker-compose.prod.yml only -------------------------------------------------------------------------
# POSTGRES_USER=ackwell
# POSTGRES_PASSWORD=CHANGE_ME
# POSTGRES_DB=ackwell
# ACKWELL_PORT=8080
