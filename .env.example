# Copy to .env for local runs. In Coolify, set these as environment variables instead.
DATABASE_URL=postgres://ackwell:CHANGE_ME@ackwell-db:5432/ackwell
PORT=3000
APP_URL=https://ackwell.joemarkgimeno.com
BETTER_AUTH_SECRET=CHANGE_ME_AT_LEAST_32_CHARS
# First-run admin: created only while the user table is empty
SEED_ADMIN_EMAIL=admin@ackwell.local
SEED_ADMIN_PASSWORD=CHANGE_ME_MIN_12_CHARS
MLLP_PORT_RANGE=6100-6150
# LAN IP the MLLP range is published on (dev compose)
MLLP_BIND_IP=172.16.10.30
# Address shown in the UI for senders (defaults to MLLP_BIND_IP in the dev compose)
MLLP_ADVERTISED_HOST=172.16.10.30
RETENTION_DEFAULT_DAYS=7
LOG_LEVEL=info
